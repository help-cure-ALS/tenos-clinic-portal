:80 {
    root * /srv
    encode zstd gzip

    # Cache static assets aggressively
    @static path *.js *.css *.svg *.png *.jpg *.woff2 *.ico
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Static assets must never fall through to the SPA shell, otherwise browsers
    # receive HTML with the wrong MIME type for missing hashed files.
    handle /app/assets/* {
        file_server
    }

    handle /app/favicon.ico {
        file_server
    }

    # SPA fallback: serve index.html for application routes only.
    handle /app/* {
        try_files {path} /app/index.html
        file_server
    }

    handle {
        file_server
    }
}
