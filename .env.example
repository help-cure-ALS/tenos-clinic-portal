# ==========================================
# HCA Medical Care — Environment Configuration
# ==========================================
# Copy to .env and adjust values.
#
# Dev:  docker compose up                           (auto-loads docker-compose.override.yml)
# Prod: docker compose -f docker-compose.yml up -d

# -------------------------
# Caddy / Ports
# -------------------------
# Prod: CADDY_SITE_ADDRESS=clinic.tenos.app   (automatic TLS via Let's Encrypt)
# Dev:  CADDY_SITE_ADDRESS=:80                      (plain HTTP)
CADDY_SITE_ADDRESS=clinic.tenos.app
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# -------------------------
# Medplum Server
# -------------------------
MEDPLUM_PORT=8103

# Prod: https://clinic.tenos.app/api/
# Dev:  http://localhost:8070/api/
MEDPLUM_BASE_URL=https://clinic.tenos.app/api/
# Medplum Admin UI is only accessible via localhost:3001 (SSH tunnel in prod)
MEDPLUM_APP_BASE_URL=http://localhost:3001/
MEDPLUM_STORAGE_BASE_URL=https://clinic.tenos.app/api/storage/
MEDPLUM_ALLOWED_ORIGINS=https://clinic.tenos.app,http://localhost:3001

MEDPLUM_REGISTER_ENABLED=true

# -------------------------
# Medplum Super Admin (created on first start if no users exist)
# -------------------------
MEDPLUM_ADMIN_EMAIL=admin@help-cure-als.org
MEDPLUM_ADMIN_PASSWORD=change_me_strong_password

# -------------------------
# Databases
# -------------------------
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me

# -------------------------
# Medplum Project & ClientApplications
# -------------------------
# Created in Medplum Admin UI (see README step 3).
# Values must match what is stored in the Medplum database.
MEDPLUM_PROJECT_ID=
VITE_MEDPLUM_CLIENT_ID=
VITE_SUPPLIER_API_URL=/sapi
VERIFICATION_MEDPLUM_CLIENT_ID=
VERIFICATION_MEDPLUM_CLIENT_SECRET=

# -------------------------
# Verification Service
# -------------------------
VERIFICATION_DB_PASSWORD=change_me
VERIFICATION_SERVICE_TOKEN=change_me_long_random
VERIFICATION_APP_AUTH_JWT_SECRET=change_me_long_random_change_me_long
VERIFICATION_APP_AUTH_JWT_ISSUER=verification-service
VERIFICATION_APP_AUTH_JWT_AUDIENCE=verification-mobile
VERIFICATION_APP_AUTH_JWT_TTL_SECONDS=900
VERIFICATION_APP_AUTH_CHALLENGE_TTL_SECONDS=60

# -------------------------
# Supplier Proxy Service
# -------------------------
SUPPLIER_PROXY_DB_PASSWORD=change_me
SUPPLIER_MEDPLUM_CLIENT_ID=
SUPPLIER_MEDPLUM_CLIENT_SECRET=
SUPPLIER_SERVICE_TOKEN=change_me_long_random
SUPPLIER_APP_AUTH_JWT_SECRET=change_me_long_random_change_me_long
SUPPLIER_APP_AUTH_JWT_ISSUER=supplier-proxy
SUPPLIER_APP_AUTH_JWT_AUDIENCE=supplier-mobile
SUPPLIER_APP_AUTH_JWT_TTL_SECONDS=900
SUPPLIER_APP_AUTH_CHALLENGE_TTL_SECONDS=60
# Dev/mono-stack: http://verification-service:3002
# Prod/separate hardware: externally or privately reachable verification base URL
VERIFICATION_SERVICE_URL=https://clinic.tenos.app/vapi
SUPPLIER_LINK_REQUEST_TTL_MINUTES=30
SUPPLIER_MAX_PULL=200
# AES-256-GCM keyring for encrypted supplier payload storage (JSON: {"version":"base64-32-byte-key"})
# Replace with a strong random key before production use.
SUPPLIER_PAYLOAD_KEYS_JSON={"1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
SUPPLIER_PAYLOAD_ACTIVE_KEY_VERSION=1
SUPPLIER_INBOUND_IDEMPOTENCY_HOURS=72
SUPPLIER_DELIVERY_WORKER_INTERVAL_MS=5000
SUPPLIER_DELIVERY_WORKER_BATCH_SIZE=20
SUPPLIER_DELIVERY_RETRY_BASE_MS=60000
SUPPLIER_DELIVERY_RETRY_MAX_MS=21600000

# -------------------------
# Studies-Sync Service (CTgov + CTIS nightly crawler + translation)
# -------------------------
STUDIES_SYNC_DB_PASSWORD=change_me
# Medplum ClientApplication for studies-sync — create in the Medplum admin
# (membership with admin rights so ResearchStudy upserts are allowed).
STUDIES_MEDPLUM_CLIENT_ID=
STUDIES_MEDPLUM_CLIENT_SECRET=
# Anthropic API key for translations (Haiku 4.5). Without a key the service
# disables translations automatically (the sync itself keeps running).
STUDIES_ANTHROPIC_API_KEY=

# -------------------------
# Offsite Backups (restic → Hetzner Object Storage, S3-compatible)
# -------------------------
# Enable by adding the "backup" Compose profile in production:
#   COMPOSE_PROFILES=backup
#
# Repository examples (pick the region of your bucket):
#   BACKUP_RESTIC_REPOSITORY=s3:hel1.your-objectstorage.com/hca-care-backups/prod
#   BACKUP_RESTIC_REPOSITORY=s3:fsn1.your-objectstorage.com/hca-care-backups/prod
#   BACKUP_RESTIC_REPOSITORY=s3:nbg1.your-objectstorage.com/hca-care-backups/prod
BACKUP_RESTIC_REPOSITORY=
BACKUP_S3_REGION=hel1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Restic encryption password. Store a copy OUTSIDE the server —
# without it the backups cannot be decrypted.
BACKUP_RESTIC_PASSWORD=change_me_long_random_backup_encryption_password
# Snapshot host name (groups snapshots in the restic repository).
BACKUP_RESTIC_HOSTNAME=hca-care
# Backup interval in seconds (default: 6 hours).
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RUN_ON_START=true
# Retention: how many daily/weekly/monthly snapshots to keep per path.
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=3
# Run `restic check` after every backup (slower; enable e.g. weekly).
BACKUP_RUN_CHECK_AFTER_BACKUP=false
# Optional: ping URL (healthchecks.io / Uptime Kuma push) called after every
# successful backup run. Leave empty to disable.
BACKUP_PING_URL=
