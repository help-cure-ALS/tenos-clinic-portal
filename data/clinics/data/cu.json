        "extension": [
          {
            "url": "http://help-cure-als.org/ext/notes",
            "valueString": "International renommiertes Zentrum fuer neurologische Wiederherstellung; gegruendet am 26. Februar 1989; Patienten aus ueber 90 Laendern; spezialisiert auf Bewegungsstoerungen, neurodegenerative Erkrankungen und neuromuskulaere Laesionen; multidisziplinaeres, intensives und personalisiertes Neurorestaurationsprogramm (bis zu 7 Stunden Therapie taeglich); Forschung in Neurowissenschaften und Neuropharmakologie; moderne Ausstattung inkl. MRT, CT, EEG, Roboter-Therapie und nicht-invasive Hirnstimulation; Oeffnungszeiten 8:30-16:30 Uhr"
          },
          {
            "url": "http://help-cure-als.org/ext/network",
            "valueString": "Internationale Partnerschaften mit Kliniken in ueber 90 Laendern"
          }
        ]
      }
